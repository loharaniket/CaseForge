# ThreatTrace AI Environment Configuration Template
# Copy this file to .env for local development

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="ThreatTrace AI API"
VERSION=0.1.0

# Security / CORS (Comma separated in production)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threattrace
POSTGRES_USER=threattrace_user
POSTGRES_PASSWORD=threattrace_secret_password
DATABASE_URL=postgresql+psycopg://threattrace_user:threattrace_secret_password@localhost:5432/threattrace

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# External Intelligence Provider API Keys (Optional - Fallbacks to deterministic local heuristics if unset)
# ThreatFox API Key (abuse.ch IP, Domain, IOC Intelligence)
THREATFOX_API_KEY=

# URLhaus API Key (abuse.ch Malicious URL Intelligence)
URLHAUS_API_KEY=

# MaxMind GeoLite2 License & Database Settings
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=
GEOIP_CITY_DB_PATH=storage/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=storage/GeoLite2-ASN.mmdb

# Cloudflare DNS 1.1.1.1 Nameservers
DNS_NAMESERVERS=["1.1.1.1","1.0.0.1"]
