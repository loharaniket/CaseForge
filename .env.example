# ThreatTrace AI Environment Configuration Template
# Copy this file to .env for local development

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="ThreatTrace AI API"
VERSION=0.1.0

# Security / CORS (Comma separated in production)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threattrace
POSTGRES_USER=threattrace_user
POSTGRES_PASSWORD=threattrace_secret_password
DATABASE_URL=postgresql+psycopg://threattrace_user:threattrace_secret_password@localhost:5432/threattrace

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
