models/checkpoints/
models/pretrained/
apps/api/models/weights/
apps/api/models/checkpoints/
apps/api/models/pretrained/
.cache/huggingface/
.cache/torch/
.cache/transformers/
**/wandb/
**/tensorboard/
**/runs/

# Large Datasets & Compressed Email Corpora
*.tar.gz
*.tar.bz2
*.tar.xz
*.zip
*.7z
*.rar
samples/raw/
samples/corpus/
samples/downloaded/
samples/datasets/

