ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="ThreatTrace AI API"
VERSION=0.1.0

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threattrace
POSTGRES_USER=threattrace_user
POSTGRES_PASSWORD=threattrace_secret_password
DATABASE_URL=postgresql+psycopg://threattrace_user:threattrace_secret_password@localhost:5432/threattrace
 
# External Intelligence Provider API Keys
THREATFOX_API_KEY=
URLHAUS_API_KEY=
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=
GEOIP_CITY_DB_PATH=storage/GeoLite2-City.mmdb
GEOIP_ASN_DB_PATH=storage/GeoLite2-ASN.mmdb
DNS_NAMESERVERS=["1.1.1.1","1.0.0.1"]
